# ────────────────────────────────────────────────────────────────
# WebAble Pro backend — environment configuration
# Copy to `.env` and fill in. Never commit `.env` to git.
# ────────────────────────────────────────────────────────────────

# Where this server lives publicly. Used for Stripe redirects + extension
# host_permissions matching. In dev: http://localhost:8787
# In prod: https://api.webable.app  (or whatever you deploy to)
PUBLIC_BASE_URL=http://localhost:8787

# Server port. Match PUBLIC_BASE_URL.
PORT=8787

# ─── Stripe ────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
# Use sk_test_... for development, sk_live_... when you flip to production.
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret — different from the API key. Get it from:
# https://dashboard.stripe.com/webhooks  →  click your endpoint  →  "Signing secret"
# In dev with `stripe listen --forward-to localhost:8787/api/webhooks/stripe`
# the CLI prints a `whsec_...` you paste here.
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe price IDs for each plan. Create them once in the Stripe dashboard
# (or via `npm run stripe:setup`) — see STRIPE_SETUP.md in the repo root.
# These are NOT product IDs. They start with `price_...`.
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...

# ─── Gemini ────────────────────────────────────────────────────
# YOUR (the operator's) Gemini API key. This is what paying users' AI calls
# get billed against. Get it from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ─── Auth ──────────────────────────────────────────────────────
# Random 64-char string used to sign user JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# CHANGE THIS BEFORE DEPLOYING. Treat it like a password.
JWT_SECRET=replace_me_with_a_real_random_secret

# How long an issued token stays valid (in days). Tokens auto-rotate when the
# extension hits /api/auth/refresh and the remaining TTL is under 7 days.
JWT_TTL_DAYS=30

# ─── Limits ────────────────────────────────────────────────────
# Daily AI generation cap per Pro subscriber. Generous default — most users
# won't hit it, but it stops a leaked token from running up your Gemini bill.
PRO_DAILY_LIMIT=500

# ─── CORS ──────────────────────────────────────────────────────
# Chrome extension origins look like `chrome-extension://abcdef...`. We allow
# any chrome-extension:// origin by default (since extension IDs are random in
# dev), plus the extension's own ID once you publish to the Web Store and pin
# it. Add comma-separated origins here.
ALLOWED_ORIGINS=chrome-extension://*

# ─── Optional ──────────────────────────────────────────────────
# Set to "1" to dump every Gemini request/response (debug only). Don't do this
# in production — request bodies contain page content.
DEBUG_GEMINI=0
